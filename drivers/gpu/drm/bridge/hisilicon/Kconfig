config DRM_HISI_HISTB_HDMI
	tristate "HiSilicon HiSTB HDMI transmitter"
	depends on DRM && OF && COMMON_CLK && I2C && RESET_CONTROLLER
	depends on ARCH_HISI || COMPILE_TEST
	select DRM_DISPLAY_HELPER
	select DRM_DISPLAY_HDMI_STATE_HELPER
	select DRM_DISPLAY_HDCP_HELPER
	select FW_LOADER
	select CRC32
	select DRM_KMS_HELPER
	select MFD_SYSCON
	select CEC_CORE
	select CEC_NOTIFIER
	select SND_SOC_HDMI_CODEC if SND_SOC
	help
	  Enable support for the HDMI transmitter integrated in the HiSilicon
	  Hi3798CV200 and Hi3798MV310. The drivers use the DRM bridge API and
	  provide physical hot-plug detection and internal DDC EDID reads.
	  MV310 uses its native hisiv100 controller and external HDMI PHY,
	  supporting progressive RGB video at 8 bpc and stereo I2S PCM. CV200
	  provides 2/6/8-channel LPCM and IEC61937/HBR audio through hdmi-codec
	  when ASoC is enabled, subject to sink capabilities. Board sound links
	  connect the AIAO CPU DAI to the transmitter's sound DAI.
	  CV200 also supports HDR10/HLG signaling for ten-bit BT.2020 RGB
	  scanout, and HDCP with the optional cipher/MCU resources and licensed
	  board firmware/key packages. These are not MV310 capabilities.

	  If M is selected, the modules are histb-hdmi and histb-hdmi-mv310.
